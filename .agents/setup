#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"

log_step() {
    printf '\n==> %s\n' "$1"
}

required_packages=(curl lua-busted lua-check luajit mpv shellcheck xauth xvfb xz-utils)
missing_packages=()
for package in "${required_packages[@]}"; do
    if ! dpkg-query -W -f='${Status}' "$package" 2>/dev/null | grep -Fq 'install ok installed'; then
        missing_packages+=("$package")
    fi
done

if ((${#missing_packages[@]})); then
    log_step "Installing system packages: ${missing_packages[*]}"
    sudo apt-get update
    sudo DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends "${missing_packages[@]}"
else
    log_step "System packages already installed"
fi

koreader_version="2026.07.1"
koreader_archive="koreader-linux-x86_64-v${koreader_version}.tar.xz"
koreader_sha256="299aadb28147a25e9432ced1214ea444a4184393b5ae97cf42402c8a61b1a1b0"
koreader_dir="$repo_root/.cache/koreader-v${koreader_version}"
koreader_url="https://github.com/koreader/koreader/releases/download/v${koreader_version}/${koreader_archive}"

if [[ ! -x "$koreader_dir/bin/koreader" ]]; then
    log_step "Downloading KOReader v${koreader_version} desktop runtime"
    archive_path="$(mktemp --suffix=.tar.xz)"
    trap 'rm -f "$archive_path"' EXIT
    curl --fail --location --retry 3 --output "$archive_path" "$koreader_url"
    printf '%s  %s\n' "$koreader_sha256" "$archive_path" | sha256sum --check --status
    rm -rf "$koreader_dir"
    mkdir -p "$koreader_dir"
    tar -xJf "$archive_path" -C "$koreader_dir"
    rm -f "$archive_path"
    trap - EXIT
else
    log_step "KOReader v${koreader_version} desktop runtime already installed"
fi

ln -sfn "koreader-v${koreader_version}" "$repo_root/.cache/koreader"
ln -sfn "$repo_root/koreadalong.koplugin" "$koreader_dir/lib/koreader/plugins/koreadalong.koplugin"

log_step "Verifying development tools"
luajit -v
luacheck --version
busted --version
mpv --version | head -n 2
shellcheck --version | head -n 2
printf 'KOReader runtime: %s\n' "$koreader_dir"
