#!/usr/bin/env python3
"""Build a plugin-only beta archive; never collect arbitrary build directories."""

import argparse
import hashlib
import json
from pathlib import Path
import re
import subprocess
import zipfile


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("version", help="for example v0.1.0-beta.1")
    parser.add_argument("--output", type=Path, default=Path("dist"))
    args = parser.parse_args()
    if not re.fullmatch(r"v(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)-beta\.([1-9][0-9]*)", args.version):
        parser.error("version must be vMAJOR.MINOR.PATCH-beta.NUMBER (no leading zeros)")

    root = Path(__file__).resolve().parent.parent
    files = sorted((root / "koreadalong.koplugin").glob("*.lua"))
    files += [root / "README.md", root / "scripts/kinamp-diagnostic"]
    files += sorted((root / "docs").glob("*.md"))
    if (root / "LICENSE").exists():
        files.append(root / "LICENSE")
    for path in files:
        if path.is_symlink() or not path.is_file():
            parser.error(f"expected a regular file: {path.relative_to(root)}")
    for name in ("main.lua", "_meta.lua"):
        if root / "koreadalong.koplugin" / name not in files:
            parser.error(f"missing plugin entry point: {name}")

    commit = subprocess.check_output(
        ["git", "rev-parse", "HEAD"], cwd=root, text=True,
    ).strip()
    modified = bool(subprocess.check_output(
        ["git", "status", "--porcelain", "--untracked-files=normal"], cwd=root,
    ).strip())
    metadata = json.dumps({
        "version": args.version,
        "source_commit": commit,
        "source_modified": modified,
        "includes": "KOReadalong plugin only; audio players and Bluetooth guard are separate",
    }, indent=2) + "\n"

    entries = {path.relative_to(root).as_posix(): path.read_bytes() for path in files}
    entries["RELEASE.json"] = metadata.encode()
    args.output.mkdir(parents=True, exist_ok=True)
    archive = args.output / f"koreadalong-{args.version}.zip"
    with zipfile.ZipFile(archive, "w", compression=zipfile.ZIP_DEFLATED) as output:
        for name, data in sorted(entries.items()):
            entry = zipfile.ZipInfo(name, date_time=(1980, 1, 1, 0, 0, 0))
            entry.create_system = 3
            entry.external_attr = (0o100644 << 16)
            entry.compress_type = zipfile.ZIP_DEFLATED
            output.writestr(entry, data)

    digest = hashlib.sha256(archive.read_bytes()).hexdigest()
    (args.output / "SHA256SUMS").write_text(f"{digest}  {archive.name}\n")
    print(f"Built {archive} ({archive.stat().st_size} bytes)")
    if modified:
        print("Preview only: source_modified=true (checkout has local changes)")
    if not (root / "LICENSE").is_file():
        print("Preview only: choose and add LICENSE before distributing")


if __name__ == "__main__":
    main()
