#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
exec 9>"$repo_root/.cache/koreadalong-smoke.lock"
if ! flock -n 9; then
    printf 'another KoReadalong smoke integration is already running\n' >&2
    exit 1
fi

smoke_root="$repo_root/.cache/koreadalong-smoke"
runtime_plugins="$repo_root/.cache/koreader-v2026.07.1/lib/koreader/plugins"
plugin_link="$runtime_plugins/koreadalongsmoke.koplugin"
epub="$smoke_root/synthetic.epub"
run_log="$smoke_root/run.log"
owned_dirs="$smoke_root/owned-dirs"

cleanup() {
    rm -f "$plugin_link"
    if [[ -f "$owned_dirs" ]]; then
        while IFS= read -r path; do
            if [[ "$path" == /tmp/koreadalong-* ]]; then
                rm -rf -- "$path"
            fi
        done < "$owned_dirs"
    fi
    rm -rf "$smoke_root"
}
trap cleanup EXIT INT TERM

rm -rf "$smoke_root"
mkdir -p "$smoke_root/book" "$smoke_root/META-INF"

SMOKE_ROOT="$smoke_root" python3 - <<'PY'
import os
import wave
import zipfile

root = os.environ["SMOKE_ROOT"]
book = os.path.join(root, "book")

for audio_name in ("first.wav", "second.wav"):
    with wave.open(os.path.join(book, audio_name), "wb") as audio:
        audio.setnchannels(1)
        audio.setsampwidth(2)
        audio.setframerate(8000)
        audio.writeframes(b"\0\0" * (48000 if audio_name == "first.wav" else 16000))

files = {
    "mimetype": "application/epub+zip",
    "META-INF/container.xml": """<?xml version="1.0" encoding="UTF-8"?>
<container version="1.0" xmlns="urn:oasis:names:tc:opendocument:xmlns:container">
  <rootfiles><rootfile full-path="book/package.opf" media-type="application/oebps-package+xml"/></rootfiles>
</container>
""",
    "book/package.opf": """<?xml version="1.0" encoding="UTF-8"?>
<package version="3.0" xmlns="http://www.idpf.org/2007/opf">
  <metadata><dc:title xmlns:dc="http://purl.org/dc/elements/1.1/">KoReadalong smoke</dc:title></metadata>
  <manifest>
    <item id="first" href="first.xhtml" media-type="application/xhtml+xml" media-overlay="first-overlay"/>
    <item id="first-overlay" href="first.smil" media-type="application/smil+xml"/>
    <item id="second" href="second.xhtml" media-type="application/xhtml+xml" media-overlay="second-overlay"/>
    <item id="second-overlay" href="second.smil" media-type="application/smil+xml"/>
  </manifest>
  <spine><itemref idref="first"/><itemref idref="second"/></spine>
</package>
""",
    "book/first.xhtml": """<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"><body><p><span id="first-sentence">The first <i>smoke</i> test <b>chapter</b>.</span> <span id="next-sentence">Another formatted <em>sentence</em>.</span></p></body></html>
""",
    "book/first.smil": """<?xml version="1.0" encoding="UTF-8"?>
<smil xmlns="http://www.w3.org/ns/SMIL"><body><seq>
  <par><text src="first.xhtml#first-sentence"/><audio src="first.wav" clipBegin="0s" clipEnd="2s"/></par>
  <par><text src="first.xhtml#first-sentence"/><audio src="first.wav" clipBegin="2s" clipEnd="4s"/></par>
  <par><text src="first.xhtml#next-sentence"/><audio src="first.wav" clipBegin="4s" clipEnd="6s"/></par>
</seq></body></smil>
""",
    "book/second.xhtml": """<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"><body><p><span id="second-sentence">The second smoke test chapter.</span></p></body></html>
""",
    "book/second.smil": """<?xml version="1.0" encoding="UTF-8"?>
<smil xmlns="http://www.w3.org/ns/SMIL"><body><seq>
  <par><text src="second.xhtml#second-sentence"/><audio src="second.wav" clipBegin="0s" clipEnd="2s"/></par>
</seq></body></smil>
""",
}

for path, content in files.items():
    with open(os.path.join(root, path), "wb") as output:
        output.write(content.encode("utf-8"))

with zipfile.ZipFile(os.path.join(root, "synthetic.epub"), "w") as epub:
    mimetype = zipfile.ZipInfo("mimetype")
    mimetype.compress_type = zipfile.ZIP_STORED
    epub.writestr(mimetype, files["mimetype"])
    for path in files:
        if path != "mimetype":
            epub.write(os.path.join(root, path), path)
    epub.write(os.path.join(book, "first.wav"), "book/first.wav")
    epub.write(os.path.join(book, "second.wav"), "book/second.wav")
PY

mkdir -p "$smoke_root/koreadalongsmoke.koplugin"
for module in "$repo_root"/koreadalong.koplugin/*.lua; do
    if [[ "$(basename "$module")" != "main.lua" ]]; then
        ln -s "$module" \
            "$smoke_root/koreadalongsmoke.koplugin/$(basename "$module")"
    fi
done
cat > "$smoke_root/koreadalongsmoke.koplugin/main.lua" <<'LUA'
local WidgetContainer = require("ui/widget/container/widgetcontainer")
local MediaOverlays = require("mediaoverlays")
local Timeline = require("timeline")
local FragmentResolver = require("fragmentresolver")
local UnderlineOverlay = require("underlineoverlay")
local Materializer = require("materializer")
local PlaybackCoordinator = require("playbackcoordinator")
local PlaybackDialog = require("playbackdialog")
local MpvAudio = require("mpvaudio")
local MpvProcess = require("mpvprocess")
local Event = require("ui/event")
local UIManager = require("ui/uimanager")
local Screen = require("device").screen
local logger = require("logger")

local Smoke = WidgetContainer:extend{
    name = "koreadalongsmoke",
    is_doc_only = true,
}

local coordinator
local playback_dialog
local quit_scheduled = false
local follow_state = "following"
local latest_range
local automatic_gotos = 0
local screenshot_dir = os.getenv("KOREADALONG_SMOKE_SCREENSHOT_DIR")

local function fail(message)
    if quit_scheduled then
        return
    end
    quit_scheduled = true
    logger.err("SMOKE_FAILURE " .. message)
    if playback_dialog then
        UIManager:close(playback_dialog)
        playback_dialog = nil
    end
    if coordinator then
        coordinator:close()
    end
    UIManager:scheduleIn(1, function()
        UIManager:quit(1)
    end)
end

local function exists(path)
    return os.rename(path, path) ~= nil
end

local function take_screenshot(name)
    if not screenshot_dir then
        return
    end
    local path = screenshot_dir .. "/" .. name .. ".png"
    local ok, error_message = pcall(function()
        Screen:shot(path)
    end)
    if not ok then
        fail("screenshot failed: " .. tostring(error_message))
    end
end

local function refresh_follow_state()
    if playback_dialog
        and type(playback_dialog.onFollowStateChanged) == "function" then
        playback_dialog:onFollowStateChanged()
    end
end

function Smoke:onReaderReady()
    if self.started then
        return
    end
    self.started = true
    local clips, parse_error = MediaOverlays.load(function(path)
        return self.document:getDocumentFileContent(path)
    end)
    assert(clips, parse_error)
    assert(#clips == 4, "expected four smoke clips")

    local direct_range, direct_error = FragmentResolver.resolve(
        self.document,
        clips[1],
        clips[3]
    )
    assert(direct_range, direct_error)
    local expected_text = {
        "The first smoke test chapter.",
        "The first smoke test chapter.",
        "Another formatted sentence.",
        "The second smoke test chapter.",
    }
    local expected_ranges = {}
    for index, clip in ipairs(clips) do
        local boundary = index < 3 and clips[3] or nil
        local range, err = FragmentResolver.resolve(self.document, clip, boundary)
        assert(range, err)
        assert(self.document:getTextFromXPointers(range.pos0, range.pos1)
            == expected_text[index], "unexpected independently specified range text")
        assert(self.document:compareXPointers(range.pos0, range.pos1) == 1)
        assert(FragmentResolver.getSpineIndex(self.document, range.pos0) == clip.spine_index,
            "normalized CRe start context differs from parser spine index")
        assert(FragmentResolver.getSpineIndex(self.document, range.pos1) == clip.spine_index,
            "normalized CRe end context differs from parser spine index")
        expected_ranges[index] = range
    end
    assert(expected_ranges[1].pos0 == expected_ranges[2].pos0)
    assert(expected_ranges[1].pos1 == expected_ranges[2].pos1)
    assert(self.document:compareXPointers(expected_ranges[1].pos1,
        expected_ranges[3].pos0) ~= -1, "distinct boundary crossed")
    logger.info("SMOKE_COMPAT inline=true repeated_targets=true exact_ranges=4")
    logger.info("SMOKE_RESOLVE ok=true text="
        .. self.document:getTextFromXPointer("#_doc_fragment_0_ first-sentence"))

    local overlay = UnderlineOverlay.new{
        dialog = self.dialog,
        document = self.document,
        ui = self.ui,
        view = self.view,
    }
    assert(overlay:register())
    local process = MpvProcess.new{
        test_only = true,
        extra_args = { "--ao=null" },
    }
    local adapter = MpvAudio.new{
        timer = UIManager,
        process = process,
    }
    local materializer = Materializer.new{}
    coordinator = PlaybackCoordinator.new{
        adapter = adapter,
        scheduler = UIManager,
        archive_reader = function(path)
            return self.document:getDocumentFileContent(path)
        end,
        materializer = materializer,
        timeline = assert(Timeline.new(clips)),
        resolver = FragmentResolver,
        document = self.document,
        overlay = overlay,
        clips = clips,
        on_range = function(pos0, pos1)
            local had_range = latest_range ~= nil
            latest_range = {
                pos0 = pos0,
                pos1 = pos1,
            }
            if follow_state == "browsing" and not had_range then
                refresh_follow_state()
            end
            if follow_state ~= "following" then
                return
            end
            if not self.document:isXPointerInCurrentPage(pos0)
                and not self.document:isXPointerInCurrentPage(pos1) then
                automatic_gotos = automatic_gotos + 1
                self.ui:handleEvent(Event:new("GotoXPointer", pos0))
                overlay:refresh()
            end
        end,
        on_error = function(error_message)
            fail("coordinator error: " .. error_message)
        end,
    }
    self.coordinator = coordinator
    self.adapter = adapter
    self.process = process
    self.materializer = materializer
    self.overlay = overlay
    local started, start_error = coordinator:start()
    if not started then
        fail("start failed: " .. tostring(start_error))
        return
    end
    playback_dialog = PlaybackDialog:new{
        coordinator = coordinator,
        scheduler = UIManager,
        get_follow_state = function()
            return follow_state
        end,
        get_return_enabled = function()
            return follow_state == "browsing"
                and latest_range ~= nil
        end,
        on_return = function()
            if not latest_range then
                return nil, "no active smoke narration range"
            end
            local range = latest_range
            follow_state = "following"
            refresh_follow_state()
            self.ui:handleEvent(Event:new("GotoXPointer", range.pos0))
            overlay:refresh()
            return true
        end,
        on_error = function(error_message)
            fail("playback dialog error: " .. tostring(error_message))
        end,
        on_close = function()
            playback_dialog = nil
        end,
    }
    UIManager:scheduleIn(0.2, function()
        if playback_dialog and not quit_scheduled then
            UIManager:show(playback_dialog)
        end
    end)

    local owned_dirs = assert(io.open(
        assert(os.getenv("KOREADALONG_SMOKE_OWNED_DIRS")),
        "w"
    ))
    owned_dirs:write(materializer.session_dir, "\n", process.session_dir, "\n")
    owned_dirs:close()

    local navigation_attempts = 0
    local eof_attempts = 0
    local browse_started = false
    local browse_scheduled = false
    local browse_returned = false
    local gotos_before_browse = 0

    local function return_to_narration()
        if not latest_range then
            fail("browse scenario lost its latest range")
            return
        end
        if automatic_gotos ~= gotos_before_browse then
            fail("narration snapped back while browsing")
            return
        end
        logger.info("SMOKE_BROWSE state=browsing snap_back=false")
        local returned, return_error = playback_dialog.on_return()
        if not returned then
            fail("return to narration failed: " .. tostring(return_error))
            return
        end
        browse_returned = true
        UIManager:scheduleIn(0.1, function()
            take_screenshot("browsing-return")
            UIManager:scheduleIn(0.1, function()
                take_screenshot("following-after-return")
            end)
        end)
        logger.info("SMOKE_RETURN state=" .. follow_state .. " range_retained=true")
    end

    local function browse_away()
        if browse_started or quit_scheduled then
            return
        end
        browse_started = true
        gotos_before_browse = automatic_gotos
        follow_state = "browsing"
        refresh_follow_state()
        local second_range, second_error = FragmentResolver.resolve(
            self.document,
            clips[4]
        )
        if not second_range then
            fail("browse target resolve failed: " .. tostring(second_error))
            return
        end
        self.ui:handleEvent(Event:new("GotoXPointer", second_range.pos0))
        UIManager:scheduleIn(0.05, function()
            take_screenshot("browsing")
        end)
        UIManager:scheduleIn(0.25, return_to_narration)
    end

    local function check_eof()
        eof_attempts = eof_attempts + 1
        if coordinator:getState() == "ended" then
            if coordinator.materialized_path ~= nil then
                fail("final EOF retained materialized audio")
                return
            end
            logger.info("SMOKE_EOF state=ended audio_removed=true")
            UIManager:scheduleIn(0.7, function()
                local audio_dir = materializer.session_dir
                if playback_dialog then
                    UIManager:close(playback_dialog)
                    playback_dialog = nil
                end
                coordinator:close()
                if exists(audio_dir) then
                    fail("materialized audio directory remains")
                    return
                end
                logger.info("SMOKE_CLOSE audio_dir_gone=true coordinator_state="
                    .. coordinator:getState())
                UIManager:scheduleIn(1, function()
                    if not process:is_done() then
                        fail("mpv process did not finish teardown")
                        return
                    end
                    if exists(process.session_dir) then
                        fail("mpv session directory remains")
                        return
                    end
                    logger.info("SMOKE_CLEANUP mpv_done=true mpv_dir_gone=true")
                    UIManager:quit(0)
                end)
            end)
            return
        end
        if eof_attempts >= 40 then
            fail("expected final EOF, got " .. coordinator:getState())
            return
        end
        UIManager:scheduleIn(0.2, check_eof)
    end
    local function check_navigation()
        navigation_attempts = navigation_attempts + 1
        local status = adapter:getStatus()
        for index, range in pairs(coordinator.range_cache) do
            if range then
                assert(range.pos0 == expected_ranges[index].pos0)
                assert(range.pos1 == expected_ranges[index].pos1)
            end
        end
        if not browse_started and not browse_scheduled
            and coordinator.current_clip_index == 1
            and coordinator.range_cache[1]
            and status.state == "playing" then
            browse_scheduled = true
            UIManager:scheduleIn(0.2, function()
                take_screenshot("following")
            end)
            UIManager:scheduleIn(0.45, browse_away)
        end
        if coordinator.current_clip_index == 4
            and coordinator.range_cache[4]
            and status.state == "playing" then
            assert(coordinator.range_cache[1] and coordinator.range_cache[2]
                and coordinator.range_cache[3], "formatted/repeated clips were not played")
            logger.info("SMOKE_COMPAT_PLAYBACK clips=4 ranges=true")
            if type(status.position) ~= "number" or status.position <= 0 then
                fail("expected second-chapter playback position")
                return
            end
            if not overlay.pos0
                or not self.document:isXPointerInCurrentPage(overlay.pos0) then
                fail("expected visible second-chapter underline")
                return
            end
            if not browse_returned then
                fail("expected return to narration before chapter transition")
                return
            end
            if automatic_gotos <= gotos_before_browse then
                fail("expected following after return to navigate chapter two")
                return
            end
            logger.info("SMOKE_PLAYBACK state=" .. status.state
                .. " position=" .. tostring(status.position)
                .. " range_cache=true audio=book/second.wav")
            logger.info("SMOKE_NAVIGATION chapter=2 range_visible=true")
            UIManager:scheduleIn(0.2, check_eof)
            return
        end
        if navigation_attempts >= 60 then
            fail("expected transition to second chapter; coordinator="
                .. coordinator:getState() .. " audio=" .. status.state
                .. " clip=" .. tostring(coordinator.current_clip_index))
            return
        end
        UIManager:scheduleIn(0.2, check_navigation)
    end
    UIManager:scheduleIn(0.2, check_navigation)
end

return Smoke
LUA

mkdir -p "$runtime_plugins"
ln -sfn "$smoke_root/koreadalongsmoke.koplugin" "$plugin_link"

mkdir -p "$smoke_root/home/.config"
status=0
HOME="$smoke_root/home" XDG_CONFIG_HOME="$smoke_root/home/.config" \
KOREADALONG_SMOKE_OWNED_DIRS="$owned_dirs" \
    timeout 20s xvfb-run -a "$repo_root/scripts/run-koreader" -d "$epub" \
    >"$run_log" 2>&1 9>&- || status=$?
cat "$run_log"
if [[ "$status" -ne 0 ]]; then
    printf 'smoke integration failed with status %s\n' "$status" >&2
    exit "$status"
fi

grep -F "SMOKE_RESOLVE ok=true" "$run_log" >/dev/null
grep -F "SMOKE_COMPAT inline=true repeated_targets=true exact_ranges=4" "$run_log" >/dev/null
grep -F "SMOKE_COMPAT_PLAYBACK clips=4 ranges=true" "$run_log" >/dev/null
grep -F "SMOKE_PLAYBACK state=playing" "$run_log" >/dev/null
grep -F "SMOKE_NAVIGATION chapter=2 range_visible=true" "$run_log" >/dev/null
grep -F "SMOKE_BROWSE state=browsing snap_back=false" "$run_log" >/dev/null
grep -F "SMOKE_RETURN state=following range_retained=true" "$run_log" >/dev/null
grep -F "SMOKE_EOF state=ended audio_removed=true" "$run_log" >/dev/null
grep -F "SMOKE_CLOSE audio_dir_gone=true coordinator_state=closed" "$run_log" >/dev/null
grep -F "SMOKE_CLEANUP mpv_done=true mpv_dir_gone=true" "$run_log" >/dev/null

while IFS= read -r path; do
    if [[ -n "$path" ]] && [[ -e "$path" ]]; then
        printf 'smoke integration left owned temporary directory: %s\n' "$path" >&2
        exit 1
    fi
done < "$owned_dirs"
